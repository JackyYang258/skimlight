{
  "manifest_version": 3,
  "name": "Skimlight",
  "version": "0.1.0",
  "description": "Highlights the key words of each sentence in web articles to help you skim. 在网页正文中标出每句的关键词，辅助快速阅读。",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Skimlight (Alt+J)" },
  "commands": {
    "toggle-jev": { "suggested_key": { "default": "Alt+J" }, "description": "开关当前页面的关键词标注" }
  }
}
